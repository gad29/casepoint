# ── CasePoint production configuration ───────────────────────────────────────
# Copy to .env.production.local on the server and fill in real values.
# next start loads this file automatically when NODE_ENV=production.

# Admin login — REQUIRED. Use a strong password (or a bcrypt hash).
ADMIN_PASSWORD=replace-with-strong-password
# ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=grhsystems@gmail.com

# Session cookie signing secret — REQUIRED. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-long-random-string
ADMIN_SESSION_HOURS=24

# Public URL of the app.
APP_BASE_URL=https://casepoint.ghsystems.work

# ── n8n integration (optional) ────────────────────────────────────────────────
# Base webhook URL of your n8n instance, e.g. https://n8n.example.com/webhook
N8N_WEBHOOK_BASE_URL=
# Token n8n sends in the x-casepoint-api-key header when reading data.
# Generate with: openssl rand -hex 32
CASEPOINT_API_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────────
# JSON database + per-client document folders live here. BACK THIS UP.
DATA_DIR=./data
# Max upload size in bytes (default 25MB). Keep in sync with nginx client_max_body_size.
UPLOAD_MAX_FILE_BYTES=26214400
