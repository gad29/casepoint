{
  "name": "CRM_YE — Task reminders (email + WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 10 }]
        }
      },
      "id": "schedule-1",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.CRMYE_APP_BASE_URL }}/api/tasks/due?markSent=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-crmye-api-key", "value": "={{ $env.CRMYE_API_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "http-1",
      "name": "Fetch due reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.reminders",
        "options": {}
      },
      "id": "split-1",
      "name": "Split reminders",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.channels }}",
              "rightValue": "email",
              "operator": { "type": "array", "operation": "contains" }
            },
            {
              "leftValue": "={{ $json.assigneeEmail }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-email",
      "name": "Email channel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.assigneeEmail }}",
        "subject": "=🔔 תזכורת: {{ $json.title }}",
        "emailType": "text",
        "message": "=שלום {{ $json.assigneeName }},\n\nתזכורת למשימה: {{ $json.title }}\n{{ $json.notes ? 'פרטים: ' + $json.notes + '\\n' : '' }}{{ $json.clientName ? 'לקוח: ' + $json.clientName + '\\n' : '' }}{{ $json.dueAt ? 'מועד יעד: ' + new Date($json.dueAt).toLocaleString('he-IL') + '\\n' : '' }}\nלרשימת המשימות: {{ $json.link }}",
        "options": {}
      },
      "id": "gmail-1",
      "name": "Send email reminder",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [880, -100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.channels }}",
              "rightValue": "whatsapp",
              "operator": { "type": "array", "operation": "contains" }
            },
            {
              "leftValue": "={{ $json.assigneePhone }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-whatsapp",
      "name": "WhatsApp channel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 120]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.assigneePhone }}",
        "textBody": "=🔔 תזכורת: {{ $json.title }}\n{{ $json.clientName ? 'לקוח: ' + $json.clientName + '\\n' : '' }}{{ $json.dueAt ? 'מועד יעד: ' + new Date($json.dueAt).toLocaleString('he-IL') : '' }}"
      },
      "id": "whatsapp-1",
      "name": "Send WhatsApp reminder",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [880, 120]
    }
  ],
  "connections": {
    "Every 10 minutes": { "main": [[{ "node": "Fetch due reminders", "type": "main", "index": 0 }]] },
    "Fetch due reminders": { "main": [[{ "node": "Split reminders", "type": "main", "index": 0 }]] },
    "Split reminders": {
      "main": [[
        { "node": "Email channel?", "type": "main", "index": 0 },
        { "node": "WhatsApp channel?", "type": "main", "index": 0 }
      ]]
    },
    "Email channel?": { "main": [[{ "node": "Send email reminder", "type": "main", "index": 0 }], []] },
    "WhatsApp channel?": { "main": [[{ "node": "Send WhatsApp reminder", "type": "main", "index": 0 }], []] }
  },
  "settings": {},
  "active": false
}
