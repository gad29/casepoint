{
  "name": "CRM_YE — Meeting request → Google Calendar",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crmye/meeting-request",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Meeting request webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "start": "={{ $json.body.start }}",
        "end": "={{ $json.body.end }}",
        "additionalFields": {
          "summary": "=פגישה: {{ $json.body.clientName }} — {{ $json.body.subject }}",
          "description": "={{ $json.body.notes }}\nטלפון: {{ $json.body.clientPhone }}",
          "attendees": ["={{ $json.body.clientEmail }}"]
        }
      },
      "id": "calendar-1",
      "name": "Create calendar event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [220, 0]
    }
  ],
  "connections": {
    "Meeting request webhook": { "main": [[{ "node": "Create calendar event", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "active": false
}
