{
  "name": "CRM_YE — Chat message notification (email / WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crmye/chat-message",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Chat message webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.recipients",
        "include": "allOtherFields",
        "options": {}
      },
      "id": "split-1",
      "name": "Split recipients",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-1",
      "name": "Has email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, -80]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=הודעה חדשה מ{{ $('Chat message webhook').item.json.body.authorName }} — {{ $('Chat message webhook').item.json.body.businessName }}",
        "emailType": "text",
        "message": "=שלום {{ $json.name }},\n\n{{ $('Chat message webhook').item.json.body.authorName }} שלח לך הודעה בצ׳אט ({{ $('Chat message webhook').item.json.body.channelName }}):\n\n\"{{ $('Chat message webhook').item.json.body.body }}\"\n\nלצפייה ולמענה: {{ $('Chat message webhook').item.json.body.link }}",
        "options": {}
      },
      "id": "gmail-1",
      "name": "Notify by email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [660, -80]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.phone }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-2",
      "name": "Has phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 120]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "textBody": "=💬 {{ $('Chat message webhook').item.json.body.authorName }}: {{ $('Chat message webhook').item.json.body.body }}\n{{ $('Chat message webhook').item.json.body.link }}"
      },
      "id": "whatsapp-1",
      "name": "Notify by WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [660, 120]
    }
  ],
  "connections": {
    "Chat message webhook": { "main": [[{ "node": "Split recipients", "type": "main", "index": 0 }]] },
    "Split recipients": {
      "main": [[
        { "node": "Has email?", "type": "main", "index": 0 },
        { "node": "Has phone?", "type": "main", "index": 0 }
      ]]
    },
    "Has email?": { "main": [[{ "node": "Notify by email", "type": "main", "index": 0 }], []] },
    "Has phone?": { "main": [[{ "node": "Notify by WhatsApp", "type": "main", "index": 0 }], []] }
  },
  "settings": {},
  "active": false
}
