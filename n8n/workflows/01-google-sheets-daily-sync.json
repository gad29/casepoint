{
  "name": "CRM_YE — Daily Google Sheets sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 7 }]
        }
      },
      "id": "schedule-1",
      "name": "Every morning 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.CRMYE_APP_BASE_URL }}/api/summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-crmye-api-key", "value": "={{ $env.CRMYE_API_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "http-1",
      "name": "Get CRM_YE summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.cases",
        "options": {}
      },
      "id": "split-1",
      "name": "Split cases",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_SPREADSHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Cases" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["caseId"],
          "value": {
            "caseId": "={{ $json.caseId }}",
            "client": "={{ $json.clientName }}",
            "phone": "={{ $json.clientPhone }}",
            "title": "={{ $json.title }}",
            "office": "={{ $json.office }}",
            "stage": "={{ $json.stageLabel }}",
            "missingDocs": "={{ $json.missingItems }}",
            "fee": "={{ $json.fee }}",
            "paid": "={{ $json.paid }}",
            "balance": "={{ $json.balance }}",
            "paymentStatus": "={{ $json.paymentStatus }}",
            "openedAt": "={{ $json.openedAt }}"
          }
        },
        "options": {}
      },
      "id": "sheets-1",
      "name": "Google Sheets — upsert case rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Every morning 07:00": { "main": [[{ "node": "Get CRM_YE summary", "type": "main", "index": 0 }]] },
    "Get CRM_YE summary": { "main": [[{ "node": "Split cases", "type": "main", "index": 0 }]] },
    "Split cases": { "main": [[{ "node": "Google Sheets — upsert case rows", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "active": false
}
