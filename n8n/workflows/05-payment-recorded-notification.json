{
  "name": "CasePoint — Payment recorded → confirmation + income sheet",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "casepoint/payment-recorded",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Payment webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_SPREADSHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Payments" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "paymentId": "={{ $json.body.paymentId }}",
            "date": "={{ $json.body.paidAt }}",
            "client": "={{ $json.body.clientName }}",
            "case": "={{ $json.body.caseTitle }}",
            "amount": "={{ $json.body.amount }}",
            "method": "={{ $json.body.method }}"
          }
        },
        "options": {}
      },
      "id": "sheets-1",
      "name": "Append to income sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 0]
    }
  ],
  "connections": {
    "Payment webhook": { "main": [[{ "node": "Append to income sheet", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "active": false
}
