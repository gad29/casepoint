{
  "name": "CRM_YE — Password reset code (email / SMS / WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crmye/password-reset",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Password reset webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "leftValue": "={{ $json.body.channel }}", "rightValue": "email", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "leftValue": "={{ $json.body.channel }}", "rightValue": "sms", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sms"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "leftValue": "={{ $json.body.channel }}", "rightValue": "whatsapp", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            }
          ]
        },
        "options": {}
      },
      "id": "switch-1",
      "name": "Route by channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.email }}",
        "subject": "🔐 קוד איפוס סיסמה — CRM_YE",
        "emailType": "text",
        "message": "=שלום {{ $json.body.name }},\n\nקוד האימות שלך לאיפוס הסיסמה: {{ $json.body.code }}\n\nהקוד תקף ל-{{ $json.body.expiresMinutes }} דקות. אם לא ביקשת איפוס — התעלם מהודעה זו.",
        "options": {}
      },
      "id": "gmail-1",
      "name": "Send code by email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [460, -120]
    },
    {
      "parameters": {
        "resource": "sms",
        "from": "REPLACE_WITH_TWILIO_NUMBER",
        "to": "={{ $json.body.phone }}",
        "message": "=CRM_YE: קוד איפוס הסיסמה שלך הוא {{ $json.body.code }} (תקף ל-{{ $json.body.expiresMinutes }} דקות)"
      },
      "id": "twilio-1",
      "name": "Send code by SMS (Twilio)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [460, 0]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.body.phone }}",
        "textBody": "=🔐 CRM_YE: קוד איפוס הסיסמה שלך הוא {{ $json.body.code }} (תקף ל-{{ $json.body.expiresMinutes }} דקות)"
      },
      "id": "whatsapp-1",
      "name": "Send code by WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [460, 120]
    }
  ],
  "connections": {
    "Password reset webhook": { "main": [[{ "node": "Route by channel", "type": "main", "index": 0 }]] },
    "Route by channel": {
      "main": [
        [{ "node": "Send code by email", "type": "main", "index": 0 }],
        [{ "node": "Send code by SMS (Twilio)", "type": "main", "index": 0 }],
        [{ "node": "Send code by WhatsApp", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {},
  "active": false
}
