{
  "name": "CRM_YE — Stage change → client email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crmye/case-stage-changed",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Stage changed webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.body.clientEmail }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-1",
      "name": "Has email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.clientEmail }}",
        "subject": "=עדכון בתיק שלך: {{ $json.body.title }}",
        "emailType": "text",
        "message": "=שלום {{ $json.body.clientName }},\n\nהתיק שלך \"{{ $json.body.title }}\" ({{ $json.body.office }}) התקדם לשלב: {{ $json.body.stageLabel }}.\n\n{{ $json.body.missingItems > 0 ? 'שים לב: חסרים עדיין ' + $json.body.missingItems + ' מסמכים.' : '' }}\n\nבברכה",
        "options": {}
      },
      "id": "gmail-1",
      "name": "Send Gmail update",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Stage changed webhook": { "main": [[{ "node": "Has email?", "type": "main", "index": 0 }]] },
    "Has email?": { "main": [[{ "node": "Send Gmail update", "type": "main", "index": 0 }], []] }
  },
  "settings": {},
  "active": false
}
