{
  "name": "CasePoint — Weekly missing-documents reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "weeks", "weeksInterval": 1, "triggerAtDay": [0], "triggerAtHour": 9 }]
        }
      },
      "id": "schedule-1",
      "name": "Sunday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.CASEPOINT_APP_BASE_URL }}/api/summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-casepoint-api-key", "value": "={{ $env.CASEPOINT_API_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "http-1",
      "name": "Get summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.cases",
        "options": {}
      },
      "id": "split-1",
      "name": "Split cases",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.missingItems }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            },
            {
              "leftValue": "={{ $json.clientEmail }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-1",
      "name": "Missing docs + has email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.clientEmail }}",
        "subject": "=תזכורת: מסמכים חסרים בתיק \"{{ $json.title }}\"",
        "emailType": "text",
        "message": "=שלום {{ $json.clientName }},\n\nבתיק \"{{ $json.title }}\" ({{ $json.office }}) חסרים עדיין {{ $json.missingItems }} מסמכים.\nנשמח שתעביר אותם בהקדם כדי שנוכל להמשיך בטיפול.\n\nתודה!",
        "options": {}
      },
      "id": "gmail-1",
      "name": "Send reminder email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [880, 0]
    }
  ],
  "connections": {
    "Sunday 09:00": { "main": [[{ "node": "Get summary", "type": "main", "index": 0 }]] },
    "Get summary": { "main": [[{ "node": "Split cases", "type": "main", "index": 0 }]] },
    "Split cases": { "main": [[{ "node": "Missing docs + has email", "type": "main", "index": 0 }]] },
    "Missing docs + has email": { "main": [[{ "node": "Send reminder email", "type": "main", "index": 0 }], []] }
  },
  "settings": {},
  "active": false
}
