{
  "name": "CRM_YE — Task assigned → notify worker",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crmye/task-assigned",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Task assigned webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.body.assigneeEmail }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-1",
      "name": "Has email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.assigneeEmail }}",
        "subject": "=📋 משימה חדשה: {{ $json.body.title }}",
        "emailType": "text",
        "message": "=שלום {{ $json.body.assigneeName }},\n\nהוקצתה לך משימה חדשה במערכת CRM_YE:\n\n{{ $json.body.title }}\n{{ $json.body.notes ? 'פרטים: ' + $json.body.notes + '\\n' : '' }}{{ $json.body.dueAt ? 'מועד יעד: ' + new Date($json.body.dueAt).toLocaleString('he-IL') + '\\n' : '' }}עדיפות: {{ $json.body.priority === 'urgent' ? 'דחוף 🚨' : $json.body.priority === 'high' ? 'חשוב' : 'רגיל' }}\n\nכניסה למערכת: {{ $env.CRMYE_APP_BASE_URL }}/tasks",
        "options": {}
      },
      "id": "gmail-1",
      "name": "Notify assignee",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Task assigned webhook": { "main": [[{ "node": "Has email?", "type": "main", "index": 0 }]] },
    "Has email?": { "main": [[{ "node": "Notify assignee", "type": "main", "index": 0 }], []] }
  },
  "settings": {},
  "active": false
}
