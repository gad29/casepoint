{
  "name": "CRM_YE — Send document to client (email / WhatsApp / SMS)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crmye/send-document",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Send document webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "leftValue": "={{ $json.body.channel }}", "rightValue": "email", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "leftValue": "={{ $json.body.channel }}", "rightValue": "sms", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sms"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "leftValue": "={{ $json.body.channel }}", "rightValue": "whatsapp", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            }
          ]
        },
        "options": {}
      },
      "id": "switch-1",
      "name": "Route by channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.clientEmail }}",
        "subject": "=מסמך מ{{ $json.body.businessName }}: {{ $json.body.documentLabel }}",
        "emailType": "text",
        "message": "=שלום {{ $json.body.clientName }},\n\nמצורף מסמך עבורך: {{ $json.body.documentLabel }}\nלצפייה והורדה: {{ $json.body.link }}\n\nהקישור בתוקף ל-{{ $json.body.expiresInDays }} ימים.\n\nבברכה,\n{{ $json.body.businessName }}",
        "options": {}
      },
      "id": "gmail-1",
      "name": "Send by email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [460, -120]
    },
    {
      "parameters": {
        "resource": "sms",
        "from": "REPLACE_WITH_TWILIO_NUMBER",
        "to": "={{ $json.body.clientPhone }}",
        "message": "={{ $json.body.businessName }}: מסמך עבורך ({{ $json.body.documentLabel }}) — {{ $json.body.link }}"
      },
      "id": "twilio-1",
      "name": "Send by SMS (Twilio)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [460, 0]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.body.clientPhone }}",
        "textBody": "=שלום {{ $json.body.clientName }}, מצורף מסמך עבורך: {{ $json.body.documentLabel }}\n{{ $json.body.link }}"
      },
      "id": "whatsapp-1",
      "name": "Send by WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [460, 120]
    }
  ],
  "connections": {
    "Send document webhook": { "main": [[{ "node": "Route by channel", "type": "main", "index": 0 }]] },
    "Route by channel": {
      "main": [
        [{ "node": "Send by email", "type": "main", "index": 0 }],
        [{ "node": "Send by SMS (Twilio)", "type": "main", "index": 0 }],
        [{ "node": "Send by WhatsApp", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {},
  "active": false
}
