# ── CRM_YE configuration ──────────────────────────────────────────────────
# Copy to .env.local and fill in real values.

# Admin login (single admin). Set a strong password before exposing the app.
# Either a plain password:
ADMIN_PASSWORD=change-me
# ...or a bcrypt hash (takes precedence when both are set):
# ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@crmye.local
# Admin phone for WhatsApp task reminders (international format, e.g. 972501234567):
ADMIN_PHONE=
# Secret for signing the session cookie (any long random string):
ADMIN_SESSION_SECRET=change-me-session-secret
ADMIN_SESSION_HOURS=24

# Public URL of the app (used for links in webhook payloads).
APP_BASE_URL=http://localhost:3000

# ── n8n integration ───────────────────────────────────────────────────────────
# Base webhook URL of your n8n instance, e.g. https://n8n.example.com/webhook
N8N_WEBHOOK_BASE_URL=
# Shared token n8n sends in the x-crmye-api-key header when reading
# data from CRM_YE (GET /api/summary etc.). Any long random string.
CRMYE_API_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────────
# Root folder for the JSON database and per-client document folders.
DATA_DIR=./data
# Max upload size in bytes (default 25MB).
UPLOAD_MAX_FILE_BYTES=26214400
